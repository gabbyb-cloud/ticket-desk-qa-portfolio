{
  "name": "ai-qa-engineer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "verify:scrypt": "tsx scripts/verify-scrypt.ts",
    "verify:checks": "node scripts/verify-checks.mjs",
    "verify:workflow": "node scripts/validate-workflow.mjs",
    "test:api": "node scripts/run-tests.mjs --project=api",
    "test:ui": "node scripts/run-tests.mjs --project=ui",
    "test:all": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
